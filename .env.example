# Single key (backward compatible). Send as X-Api-Key.
KEEL_A2A_API_KEY=keel-demo-key

# Optional extra keys (comma-separated)
# KEEL_A2A_API_KEYS=key_one,key_two

# Optional JSON or customer_id=key file
# KEEL_A2A_API_KEYS_FILE=./keys.json

# Persist generated key here if none of the above are set
# KEEL_A2A_KEY_FILE=.data/keel-api-key

# HTTP bind
PORT=47821
HOST=127.0.0.1

# Calendar: mock | motion | calcom  (motion/calcom fail loud without creds)
CALENDAR_PROVIDER=mock
# MOTION_API_KEY=
# CALCOM_API_KEY=

# Confirmation out (optional). Skip SMTP send when unset.
# BOOKING_WEBHOOK_URL=https://example.test/keel-bookings
# SMTP_URL=
ICS_ARTIFACTS_DIR=artifacts

# Public product copy (do not invent pricing or legal claims)
KEEL_PUBLIC_SITE=https://keelops.au

# Demo client target
KEEL_BASE_URL=http://127.0.0.1:47821
